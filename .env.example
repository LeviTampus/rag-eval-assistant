# Copy this file to ".env" and fill in your values.
# ".env" is gitignored, so your keys stay local.

# --- LLM (OpenAI-compatible) ---
#   Groq:   https://api.groq.com/openai/v1
#   Ollama: http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=your-key-here

# Embeddings are local (Chroma's default MiniLM) — no key needed.

# --- LangSmith tracing + eval experiments (optional, free tier) ---
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=rag-eval-assistant
LANGSMITH_API_KEY=your-langsmith-key

# --- Behind a corporate proxy / TLS inspection? ---
# Set the CA bundle in your SHELL or IDE Run config (not here — httpx/SSL
# reads it at import time, before .env is loaded):
#   export SSL_CERT_FILE=/path/to/ca-combined.pem
